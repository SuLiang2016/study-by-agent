---
import type { Resource } from '../lib/types';
import { TYPE_LABEL } from '../lib/types';
import { maintenanceDisplay } from '../lib/maintenance';

interface Props {
  resource: Resource;
  /** 路径步骤序号（①②…），仅阶段页使用 */
  order?: string;
}

const { resource: r, order } = Astro.props;
const maint = maintenanceDisplay(r.maintenance);
---

<article
  class="card resource-card"
  data-resource-card
  data-id={r.id}
  data-stages={r.stages.join(',')}
  data-category={r.category}
  data-type={r.type}
  data-maintenance={maint.key}
>
  <div class="resource-head">
    {order && <span class="order-chip" aria-label={`顺序 ${order}`}>{order}</span>}
    <h3 class="resource-name">
      <a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a>
    </h3>
    <span class="badge badge-type">{TYPE_LABEL[r.type]}</span>
  </div>

  <p class="resource-note">{r.note}</p>

  <div class="resource-meta">
    {r.stages.map((s) => (
      <span class={`badge badge-stage stage-${s}`}>阶段 {s}</span>
    ))}
    <span class={`badge badge-maint ${maint.className}`} title={r.pushedAt ? `最近推送 ${r.pushedAt}` : undefined}>
      {maint.label}
    </span>
    <span class="meta-item" title={r.stars != null ? `${r.stars.toLocaleString('en-US')} stars` : '非 GitHub 资源，无 star 数据'}>
      ★ {r.stars != null ? r.stars.toLocaleString('en-US') : '—'}
    </span>
    {r.language && <span class="meta-item">{r.language}</span>}
    <span class="meta-item">核实于 {r.verifiedAt}</span>
  </div>

  <button class="done-toggle" type="button" data-progress-toggle data-id={r.id} aria-pressed="false">
    <span class="tick" aria-hidden="true">✓</span>
    <span data-progress-label>标记已学</span>
  </button>
</article>
